---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/url";
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n’existe pas ou a été déplacée."
  path="404.html"
  noindex
>
  <section class="container-page grid min-h-[60dvh] place-items-center py-20 text-center">
    <div class="max-w-xl">
      <p class="font-display text-primary text-[clamp(5rem,18vw,9rem)] leading-none font-semibold">
        404
      </p>
      <h1 class="text-ink mt-4 text-3xl font-semibold md:text-4xl">
        Page introuvable
      </h1>
      <p class="text-muted mt-4 text-lg">
        Oups, cette page n’existe pas ou a été déplacée. Pas de panique, voici
        quelques pistes&nbsp;:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={url()} class="btn btn-primary">
          <Icon name="arrow-left" size={18} />
          Retour à l’accueil
        </a>
        <a href={url("evenements/")} class="btn btn-ghost">
          Voir nos événements
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
