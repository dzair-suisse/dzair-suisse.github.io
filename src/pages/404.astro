---
/**
 * GitHub Pages serves this single 404.html for every language, so the page
 * shows French and English side by side (French chrome, English block marked
 * `lang="en"`), without JavaScript.
 */
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath, useTranslations } from "../i18n/utils";
import { url } from "../lib/url";

const fr = useTranslations("fr");
const en = useTranslations("en");
const blocks = [
  { lang: "fr", t: fr, home: url(), events: url("evenements/") },
  {
    lang: "en",
    t: en,
    home: url(localizedPath("", "en")),
    events: url(localizedPath("evenements/", "en")),
  },
] as const;
---

<BaseLayout
  lang="fr"
  title={`${fr.notFound.title} / ${en.notFound.title}`}
  description={fr.notFound.description}
  path="404.html"
  noindex
>
  <section class="container-page grid min-h-[60dvh] place-items-center py-20 text-center">
    <div class="max-w-xl">
      <p class="font-display text-primary text-[clamp(5rem,18vw,9rem)] leading-none font-semibold">
        404
      </p>
      <div class="flex flex-col gap-12">
        {blocks.map(({ lang, t, home, events }, i) => (
          <div lang={lang}>
            {i === 0 ? (
              <h1 class="text-ink mt-4 text-3xl font-semibold md:text-4xl">
                {t.notFound.title}
              </h1>
            ) : (
              <h2 class="text-ink mt-4 text-3xl font-semibold md:text-4xl">
                {t.notFound.title}
              </h2>
            )}
            <p class="text-muted mt-4 text-lg">{t.notFound.text}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              <a href={home} class="btn btn-primary">
                <Icon name="arrow-left" size={18} />
                {t.notFound.back}
              </a>
              <a href={events} class="btn btn-ghost">
                {t.seeEvents}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
