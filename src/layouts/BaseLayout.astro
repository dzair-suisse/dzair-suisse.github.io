---
import "@fontsource-variable/montserrat";
import "@fontsource-variable/fraunces";
import "../styles/global.css";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import montserratLatin from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LanguageBanner from "../components/LanguageBanner.astro";
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import { HTML_LANG } from "../i18n/routes";
import { localizedPath, useTranslations } from "../i18n/utils";
import { url } from "../lib/url";

type Props = SEOProps & {
  /**
   * French home page only: send visitors who chose English (stored with the
   * language switcher) to the English home page before first paint.
   */
  redirectToPreferred?: boolean;
};

const { redirectToPreferred = false, ...props } = Astro.props;
const { lang } = props;
const t = useTranslations(lang);
const englishHome = url(localizedPath("", "en"));
---

<!doctype html>
<html lang={HTML_LANG[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Apply the stored / preferred theme before first paint (no flash).
      Re-applied after every view-transition swap, since the new document's
      <html> element does not carry the attribute.
    -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {
            /* storage unavailable */
          }
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          doc.documentElement.dataset.theme = theme;
        };
        apply(document);
        if (!window.__dzairTheme) {
          window.__dzairTheme = true;
          document.addEventListener("astro:before-swap", (e) =>
            apply(e.newDocument),
          );
          matchMedia("(prefers-color-scheme: dark)").addEventListener(
            "change",
            () => {
              let stored = null;
              try {
                stored = localStorage.getItem("theme");
              } catch {
                /* storage unavailable */
              }
              if (stored) return;
              apply(document);
              // Lets the theme toggle(s) update aria-pressed.
              document.dispatchEvent(new CustomEvent("themechange"));
            },
          );
        }
      })();
    </script>

    {redirectToPreferred && <script is:inline define:vars={{ englishHome }}>
      try {
        if (localStorage.getItem("lang") === "en") {
          document.documentElement.style.visibility = "hidden";
          location.replace(englishHome + location.search + location.hash);
        }
      } catch {
        /* storage unavailable */
      }
    </script>}

    <!--
      Language banner (see LanguageBanner.astro): shown before first paint when
      the browser language is the other site language and the visitor has
      neither chosen a language nor dismissed the banner.
    -->
    <script is:inline>
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const apply = (doc) => {
          const root = doc.documentElement;
          const other = root.lang === "en" ? "fr" : "en";
          const browser = (navigator.language || "").toLowerCase();
          if (
            !read("lang") &&
            !read("lang-banner-dismissed") &&
            browser.startsWith(other)
          )
            root.dataset.langBanner = "";
          else delete root.dataset.langBanner;
        };
        apply(document);
        if (!window.__dzairLangBanner) {
          window.__dzairLangBanner = true;
          document.addEventListener("astro:before-swap", (e) =>
            apply(e.newDocument),
          );
        }
      })();
    </script>

    <!-- Latin subsets of the heading (LCP) and body fonts. -->
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={montserratLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SEO {...props} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#contenu" class="skip-link">
      {t.a11y.skipLink}
    </a>
    {!props.noindex && <LanguageBanner lang={lang} path={props.path ?? ""} />}
    <Header lang={lang} />
    <main id="contenu" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
