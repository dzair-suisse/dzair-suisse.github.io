---
import { getImage, Picture } from "astro:assets";
import { CATEGORY_LABELS } from "../lib/categories";
import type { EventEntry } from "../lib/events";
import { formatMonth, isoMonth } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  event: EventEntry;
  headingLevel?: "h2" | "h3";
  /** Load the image eagerly (first cards above the fold). */
  eager?: boolean;
  /** Show the category label on the card (useful outside grouped lists). */
  showCategory?: boolean;
}

const {
  event,
  headingLevel = "h3",
  eager = false,
  showCategory = false,
} = Astro.props;
const { title, date, location, image, alt, category } = event.data;
const Heading = headingLevel;
const when = formatMonth(date);

// Larger rendition opened by the lightbox (or directly, without JS).
const full = await getImage({
  src: image,
  width: Math.min(1400, image.width),
  format: "webp",
});
---

<article
  class="event-card card group flex h-full flex-col overflow-hidden"
  data-category={category}
>
  <a
    href={full.src}
    class="event-media bg-surface-2 relative block overflow-hidden"
    data-lightbox
    data-astro-reload
    data-lightbox-alt={alt}
    data-lightbox-caption={`${title} — ${when} · ${location}`}
  >
    <span class="sr-only">Agrandir la photo :</span>
    <Picture
      src={image}
      alt={alt}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 72rem) 17rem, (min-width: 52rem) 30vw, (min-width: 34rem) 46vw, 92vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="size-full object-cover object-top transition-transform duration-500 ease-(--ease-out-soft) group-hover:scale-[1.03]"
      transition:name={`event-${event.id}`}
    />
    <span
      class="bg-surface/90 text-ink absolute end-3 bottom-3 inline-grid size-10 place-items-center rounded-full opacity-0 shadow-md backdrop-blur transition-opacity group-focus-within:opacity-100 group-hover:opacity-100"
      aria-hidden="true"
    >
      <Icon name="zoom" size={20} />
    </span>
  </a>

  <div class="flex flex-1 flex-col gap-3 p-5">
    {showCategory && (
      <p class="text-sage text-xs font-semibold tracking-[0.1em] uppercase">
        {CATEGORY_LABELS[category]}
      </p>
    )}
    <Heading class="text-ink text-lg leading-snug font-semibold">
      {title}
    </Heading>
    <p class="event-meta text-muted mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={16} />
        <time datetime={isoMonth(date)}>{when}</time>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="map-pin" size={16} />
        {location}
      </span>
    </p>
  </div>
</article>
