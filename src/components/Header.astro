---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo-dzair.png";
import { localizedPath, useTranslations, type Lang } from "../i18n/utils";
import { SITE } from "../lib/site";
import { stripBase, url } from "../lib/url";
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const current = stripBase(Astro.url.pathname);
const home = localizedPath("", lang);
const events = localizedPath("evenements/", lang);

const links: { href: string; label: string; match?: string }[] = [
  { href: url(home), label: t.nav.home, match: stripBase(url(home)) },
  { href: url(`${home}#quisommesnous`), label: t.nav.about },
  { href: url(events), label: t.nav.events, match: stripBase(url(events)) },
  { href: url(`${home}#contact`), label: t.nav.contact },
];

function isCurrent(link: (typeof links)[number]): boolean {
  return link.match === current;
}
---

<header
  class="sticky top-0 z-50 border-b border-[color-mix(in_oklch,var(--border)_70%,transparent)] bg-(--header-bg) backdrop-blur-xl backdrop-saturate-150"
  transition:name="site-header"
>
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-4">
    <a
      href={url(home)}
      class="logo-link flex items-center rounded-xl px-1.5 py-1"
      aria-label={t.nav.logo}
      transition:name="site-logo"
    >
      <Image
        src={logo}
        alt=""
        width={140}
        densities={[1, 2]}
        loading="eager"
        class="h-auto w-[7.5rem] sm:w-[8.75rem]"
      />
    </a>

    <nav aria-label={t.nav.main} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link"
              aria-current={isCurrent(link) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} class="hidden sm:flex" />
      <ThemeToggle lang={lang} />
      <a
        href={SITE.joinForm}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary hidden py-2! text-sm sm:inline-flex"
      >
        {t.join}
        <Icon name="external" size={16} />
        <span class="sr-only">{t.a11y.newTab}</span>
      </a>
      <button
        type="button"
        class="text-ink hover:bg-surface-2 inline-grid size-11 place-items-center rounded-full lg:hidden"
        commandfor="mobile-menu"
        command="show-modal"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={24} />
        <span class="sr-only">{t.nav.openMenu}</span>
      </button>
    </div>
  </div>

  <!--
    Modal dialog: the page behind is inert, Tab stays inside, Esc closes it and
    focus goes back to the menu button. Opened via an invoker command
    (`commandfor`), with a script fallback for browsers without it.
  -->
  <dialog
    id="mobile-menu"
    class="mobile-menu lg:hidden"
    aria-labelledby="mobile-menu-title"
  >
    <div class="mb-4 flex items-center justify-between">
      <p id="mobile-menu-title" class="font-display text-xl font-semibold">
        {t.nav.menu}
      </p>
      <form method="dialog">
        <button
          type="submit"
          class="hover:bg-surface-2 inline-grid size-11 place-items-center rounded-full"
        >
          <Icon name="close" size={24} />
          <span class="sr-only">{t.nav.closeMenu}</span>
        </button>
      </form>
    </div>
    <nav aria-label={t.nav.mobile}>
      <ul class="flex flex-col gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="hover:bg-surface-2 aria-[current=page]:text-primary block rounded-xl px-3 py-3 text-lg font-semibold"
              aria-current={isCurrent(link) ? "page" : undefined}
              data-close-menu
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={SITE.joinForm}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mt-5 w-full"
        data-close-menu
      >
        {t.join}
        <Icon name="external" size={18} />
        <span class="sr-only">{t.a11y.newTab}</span>
      </a>
    </nav>
    <LanguageSwitcher
      lang={lang}
      class="border-line mt-5 justify-center border-t pt-4"
    />
  </dialog>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav-link:hover {
    background: var(--surface-2);
  }
  .nav-link[aria-current="page"] {
    color: var(--primary);
    font-weight: 650;
  }
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.8rem;
    inset-block-end: 0.2rem;
    block-size: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  /* The logo has dark-green lettering: give it a light pill in dark mode. */
  :global([data-theme="dark"]) .logo-link {
    background: oklch(97% 0.01 90);
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .logo-link {
      background: oklch(97% 0.01 90);
    }
  }
</style>

<script>
  const supportsInvokers = "commandForElement" in HTMLButtonElement.prototype;
  const desktop = matchMedia("(min-width: 64rem)");

  // Bound per page: the header is re-rendered on every ClientRouter navigation.
  function bindMenu(): void {
    const menu = document.getElementById("mobile-menu") as HTMLDialogElement;
    const opener =
      document.querySelector<HTMLButtonElement>("[data-menu-open]");
    if (!menu || !opener || menu.dataset["bound"]) return;
    menu.dataset["bound"] = "true";

    if (!supportsInvokers) {
      opener.addEventListener("click", () => {
        if (!menu.open) menu.showModal();
      });
    }

    // Close when a link inside is followed (incl. same-page anchors).
    menu.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      if (target?.closest("[data-close-menu]")) return menu.close();
      // Click on the backdrop (outside the sheet's box).
      if (target === menu) {
        const r = menu.getBoundingClientRect();
        const inside =
          event.clientX >= r.left &&
          event.clientX <= r.right &&
          event.clientY >= r.top &&
          event.clientY <= r.bottom;
        if (!inside) menu.close();
      }
    });

    // Focus back on the menu button (Esc, close button, link to an anchor).
    menu.addEventListener("close", () => {
      if (opener.isConnected) opener.focus();
    });
  }

  // The menu is hidden from the lg breakpoint: never leave the page inert.
  desktop.addEventListener("change", (event) => {
    const menu = document.getElementById("mobile-menu") as HTMLDialogElement;
    if (event.matches && menu?.open) menu.close();
  });

  document.addEventListener("astro:page-load", bindMenu);
</script>
