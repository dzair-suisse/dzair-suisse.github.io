---
/**
 * Decorative zellige lattice: eight-point stars (khatam) on a repeating tile,
 * drawn with `currentColor` so the parent sets its colour and opacity.
 *
 * Inspired by the 14th-century Zianid zellige of Tlemcen: the Tachfinia
 * madrasa used eight- and sixteen-point star patterns, a style also found on
 * the portal of the Sidi Boumediene mosque. (The Casbah of Algiers is known for
 * painted faience tiles rather than zellige, so it is not the reference here.)
 */
interface Props {
  /** Unique id for the SVG <pattern> (several patterns per page). */
  id: string;
  class?: string;
  /** Tile size in px. */
  size?: number;
}

const { id, class: className, size = 56 } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  class:list={["zellige", className]}
  width="100%"
  height="100%"
>
  <defs>
    <pattern
      id={id}
      width={size}
      height={size}
      patternUnits="userSpaceOnUse"
      viewBox="0 0 40 40"
    >
      <g fill="none" stroke="currentColor" stroke-width="0.9">
        <!-- Eight-point star: a square and the same square turned 45°. -->
        <polygon points="11,11 29,11 29,29 11,29"></polygon>
        <polygon points="20,7.3 32.7,20 20,32.7 7.3,20"></polygon>
        <circle cx="20" cy="20" r="3.2"></circle>
        <!-- Diamonds on the tile corners link the stars into a lattice. -->
        <polygon points="0,-5 5,0 0,5 -5,0"></polygon>
        <polygon points="40,-5 45,0 40,5 35,0"></polygon>
        <polygon points="0,35 5,40 0,45 -5,40"></polygon>
        <polygon points="40,35 45,40 40,45 35,40"></polygon>
        <path d="M5 0 H11 M29 0 H35 M5 40 H11 M29 40 H35 M0 5 V11 M0 29 V35 M40 5 V11 M40 29 V35"></path>
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  .zellige {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }
</style>
