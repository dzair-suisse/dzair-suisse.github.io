---
import { Picture } from "astro:assets";
import heroBoat from "../../assets/events/randonnee-stanserhorn-2025.jpeg";
import heroHike from "../../assets/events/randonnee-crans-montana-2025.jpeg";
import heroTalk from "../../assets/events/entraide-post-epfl-2025.jpeg";
import logo from "../../assets/brand/logo-dzair.png";
import EventCard from "../EventCard.astro";
import Icon, { type IconName } from "../Icon.astro";
import Lightbox from "../Lightbox.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedEvents } from "../../lib/events";
import { SITE } from "../../lib/site";
import { absoluteUrl, url } from "../../lib/url";
import { CONTENT_LANG } from "../../i18n/routes";
import { localizedPath, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = localizedPath("", lang);
const eventsUrl = url(localizedPath("evenements/", lang));

const latest = (await getSortedEvents()).slice(0, 3);

const values: { icon: IconName; title: string; text: string }[] = [
  { icon: "compass", ...t.home.values.integration },
  { icon: "handshake", ...t.home.values.support },
  { icon: "sparkles", ...t.home.values.culture },
];

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.legalName,
  alternateName: SITE.name,
  url: absoluteUrl("", Astro.site),
  logo: absoluteUrl("icon-512.png", Astro.site),
  email: SITE.email,
  description: t.site.description,
  sameAs: [SITE.instagram, SITE.linkedin],
};

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t.site.title,
  url: absoluteUrl(path, Astro.site),
  inLanguage: CONTENT_LANG[lang],
  about: { "@type": "Organization", name: SITE.legalName },
};
---

<BaseLayout
  lang={lang}
  path={path}
  jsonLd={[organization, webPage]}
  redirectToPreferred={lang === "fr"}
>
  <!-- Hero ------------------------------------------------------------ -->
  <section id="accueil" class="relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="hero-glow pointer-events-none absolute inset-0 -z-10"
    ></div>
    <div class="container-page grid items-center gap-12 pt-12 pb-20 md:pt-20 lg:grid-cols-[1.15fr_1fr] lg:pb-28">
      <div>
        <p class="eyebrow mb-5">{t.site.recognised}</p>
        <h1 class="text-ink text-[clamp(2.6rem,7vw,5rem)] font-semibold">
          <span class="text-primary">DZAÏR</span>&nbsp;
          <span class="text-accent">–</span>
          <span class="block">{t.home.heroLine}</span>
        </h1>
        <p class="text-muted mt-6 max-w-[38rem] text-lg leading-relaxed">
          {t.home.intro}
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={SITE.joinForm}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            {t.join}
            <Icon name="external" size={18} />
            <span class="sr-only">{t.a11y.newTab}</span>
          </a>
          <a href={eventsUrl} class="btn btn-ghost">
            {t.seeEvents}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>

      <div
        class="hero-collage relative mx-auto aspect-[16/11] w-full max-w-xl sm:aspect-[5/4]"
        aria-hidden="true"
      >
        <div class="collage-a card absolute overflow-hidden p-0">
          <Picture
            src={heroBoat}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[400, 640, 900]}
            sizes="(min-width: 64rem) 34rem, 90vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover"
          />
        </div>
        <div class="collage-b card float absolute hidden overflow-hidden p-0 sm:block">
          <Picture
            src={heroHike}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[320, 480]}
            sizes="(min-width: 64rem) 15rem, 40vw"
            class="size-full object-cover"
          />
        </div>
        <div class="collage-c card absolute hidden overflow-hidden p-0 sm:block">
          <Picture
            src={heroTalk}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[320, 480]}
            sizes="(min-width: 64rem) 13rem, 36vw"
            class="size-full object-cover"
          />
        </div>
        <div class="collage-badge card absolute grid place-items-center bg-white p-3">
          <Picture
            src={logo}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            width={180}
            densities={[1, 2]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Qui sommes-nous -------------------------------------------------- -->
  <section
    id="quisommesnous"
    class="bg-bg-soft border-line border-y py-20 md:py-28"
  >
    <div class="container-page">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-4">{t.home.aboutEyebrow}</p>
        <h2 class="text-ink text-4xl font-semibold md:text-5xl">
          {t.home.aboutTitle}
        </h2>
        <p class="text-muted mt-5 text-lg">{t.home.aboutLead}</p>
      </div>
      <ul class="values mt-12 grid gap-5 md:grid-cols-3">
        {values.map((value) => (
          <li class="value-card card reveal p-7">
            <span class="bg-surface-2 text-primary mb-6 inline-grid size-14 place-items-center rounded-2xl">
              <Icon name={value.icon} size={28} />
            </span>
            <h3 class="text-ink text-2xl font-semibold">{value.title}</h3>
            <p class="text-muted mt-3">{value.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Derniers événements ---------------------------------------------- -->
  <section
    id="evenements"
    class="py-20 md:py-28"
    aria-labelledby="latest-title"
  >
    <div class="container-page">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow mb-4">{t.home.latestEyebrow}</p>
          <h2
            id="latest-title"
            class="text-ink text-4xl font-semibold md:text-5xl"
          >
            {t.home.latestTitle}
          </h2>
        </div>
        <a href={eventsUrl} class="btn btn-ghost">
          {t.home.allEvents}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="event-grid mt-10">
        <ul class="latest-grid">
          {latest.map((event) => (
            <li class="reveal">
              <EventCard
                event={event}
                lang={lang}
                showCategory
                sizes="(min-width: 72rem) 22rem, (min-width: 44rem) 31vw, 92vw"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact ----------------------------------------------------------- -->
  <section id="contact" class="pb-8" aria-labelledby="contact-title">
    <div class="container-page">
      <div class="contact-panel reveal relative isolate overflow-hidden rounded-[2rem] px-6 py-14 text-center sm:px-12 md:py-20">
        <p class="eyebrow mb-4 justify-center text-white/80">
          {t.home.contactEyebrow}
        </p>
        <h2
          id="contact-title"
          class="mx-auto max-w-2xl text-3xl font-semibold text-white md:text-5xl"
        >
          {t.home.contactTitle}
        </h2>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="btn text-brand-green bg-white hover:bg-white/90"
          >
            <Icon name="instagram" size={20} />
            @dzair_suisse
            <span class="sr-only">{t.home.onInstagram}</span>
            <Icon name="external" size={16} />
          </a>
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn border-[1.5px] border-white/50 text-white hover:bg-white/10"
          >
            <Icon name="linkedin" size={20} />
            LinkedIn
            <span class="sr-only">{t.a11y.newTab}</span>
            <Icon name="external" size={16} />
          </a>
          <a
            href={`mailto:${SITE.email}`}
            class="btn border-[1.5px] border-white/50 text-white hover:bg-white/10"
          >
            <Icon name="mail" size={20} />
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </section>

  <Lightbox lang={lang} />
</BaseLayout>

<style>
  .hero-glow {
    background:
      radial-gradient(
        60rem 30rem at 85% -10%,
        color-mix(in oklch, var(--sage) 28%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40rem 24rem at -10% 110%,
        color-mix(in oklch, var(--accent) 10%, transparent),
        transparent 70%
      );
  }

  .collage-a {
    inset-inline: 0 18%;
    inset-block: 6% 14%;
    rotate: -2deg;
  }
  /* Phones: one large photo + badge only (shorter hero). */
  @media (width < 40rem) {
    .collage-a {
      inset-inline: 0 2%;
      inset-block: 0 6%;
    }
  }
  .collage-b {
    inline-size: 40%;
    aspect-ratio: 1;
    inset-inline-end: 0;
    inset-block-start: 0;
    rotate: 4deg;
  }
  .collage-c {
    inline-size: 36%;
    aspect-ratio: 1;
    inset-inline-end: 6%;
    inset-block-end: 0;
    rotate: -3deg;
  }
  .collage-badge {
    inline-size: 30%;
    inset-inline-start: -2%;
    inset-block-end: 2%;
    border-radius: 1rem;
  }

  .latest-grid {
    grid-template-columns: 1fr;
  }
  /* Straight from 1 to 3 columns: no orphan third card in a 2-column grid. */
  @container events (min-width: 40rem) {
    .latest-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Highlight the hovered value card, dim its siblings (:has()). */
  @media (hover: hover) {
    .values:has(.value-card:hover) .value-card:not(:hover) {
      opacity: 0.72;
    }
    .value-card {
      transition:
        opacity 0.25s,
        translate 0.25s;
    }
    .value-card:hover {
      translate: 0 -4px;
    }
  }

  .contact-panel {
    /* Light focus ring on the dark green panel (≥ 3:1 in both themes). */
    --focus: oklch(92% 0.09 95);
    background:
      radial-gradient(
        30rem 20rem at 100% 0%,
        oklch(52% 0.2 22 / 0.35),
        transparent 70%
      ),
      linear-gradient(135deg, var(--brand-green), oklch(30% 0.06 168));
  }
</style>
