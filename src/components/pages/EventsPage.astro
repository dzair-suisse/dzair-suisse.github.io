---
import EventCard from "../EventCard.astro";
import Lightbox from "../Lightbox.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTENT_LANG } from "../../i18n/routes";
import { localizedPath, useTranslations, type Lang } from "../../i18n/utils";
import { CATEGORIES } from "../../lib/categories";
import { getSortedEvents } from "../../lib/events";
import { SITE } from "../../lib/site";
import { absoluteUrl } from "../../lib/url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = localizedPath("evenements/", lang);

const events = await getSortedEvents();
const groups = CATEGORIES.map((category) => ({
  category,
  label: t.categories[category],
  events: events.filter((event) => event.data.category === category),
})).filter((group) => group.events.length > 0);

const webPage = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t.events.title,
  description: t.events.description,
  url: absoluteUrl(path, Astro.site),
  inLanguage: CONTENT_LANG[lang],
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: absoluteUrl("", Astro.site),
  },
};

/*
 * CSS-only filter (works without JS): when a category chip is checked, hide
 * the other categories. Generated from CATEGORIES so both always match.
 */
const filterCss = `${CATEGORIES.map(
  (c) =>
    `.events-page:has(#filtre-${c}:checked) [data-category]:not([data-category="${c}"])`,
).join(", ")} { display: none; }`;
---

<BaseLayout
  lang={lang}
  title={t.events.title}
  description={t.events.description}
  path={path}
  jsonLd={[webPage]}
>
  <style is:inline set:html={filterCss}></style>
  <div class="events-page">
    <section
      class="relative isolate overflow-hidden pt-14 pb-10 md:pt-20"
      aria-labelledby="events-title"
    >
      <div
        aria-hidden="true"
        class="events-glow pointer-events-none absolute inset-0 -z-10"
      ></div>
      <div class="container-page">
        <p class="eyebrow mb-4">{t.events.eyebrow}</p>
        <h1
          id="events-title"
          class="text-ink text-[clamp(2.6rem,7vw,4.5rem)] font-semibold"
        >
          {t.events.heading}
        </h1>
        <p class="text-muted mt-5 max-w-2xl text-lg">{t.events.lead}</p>

        <div class="mt-10" data-filter>
          <fieldset>
            <legend class="text-muted mb-3 text-sm font-semibold">
              {t.events.filterLegend}
            </legend>
            <div class="chip-row">
              <label class="chip">
                <input
                  type="radio"
                  name="categorie"
                  value="tous"
                  id="filtre-tous"
                  checked
                />
                {t.events.all}
                <span class="chip-count">({events.length})</span>
              </label>
              {groups.map((group) => (
                <label class="chip">
                  <input
                    type="radio"
                    name="categorie"
                    value={group.category}
                    id={`filtre-${group.category}`}
                  />
                  {group.label}
                  <span class="chip-count">({group.events.length})</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p
            class="sr-only"
            role="status"
            aria-live="polite"
            data-filter-status
            data-status-one={t.events.shown.one}
            data-status-other={t.events.shown.other}
          ></p>
        </div>
      </div>
    </section>

    <div id="events-list" class="container-page space-y-16 pb-8">
      {groups.map((group) => (
        <section
          data-category={group.category}
          aria-labelledby={`cat-${group.category}`}
          class="scroll-mt-28"
        >
          <div class="border-line mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b pb-3">
            <h2
              id={`cat-${group.category}`}
              class="text-ink text-2xl font-semibold md:text-3xl"
            >
              {group.label}
            </h2>
            <p class="text-muted text-sm">
              {t.events.count(group.events.length)}
            </p>
          </div>
          <div class="event-grid">
            <ul>
              {group.events.map((event, i) => (
                <li class="reveal">
                  <EventCard
                    event={event}
                    lang={lang}
                    eager={group === groups[0] && i < 2}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </div>

  <Lightbox lang={lang} />
</BaseLayout>

<style>
  .events-glow {
    background: radial-gradient(
      50rem 26rem at 90% -20%,
      color-mix(in oklch, var(--sage) 26%, transparent),
      transparent 70%
    );
  }
</style>

<script>
  /*
   * Progressive enhancement: filtering itself is pure CSS (`:has()` on the
   * radio inputs, see global.css). This script only keeps the choice in the
   * URL (?categorie=…) and announces the number of visible events.
   */
  function initFilter(): void {
    const form = document.querySelector<HTMLElement>("[data-filter]");
    if (!form || form.dataset["bound"]) return;
    form.dataset["bound"] = "true";
    const status = form.querySelector<HTMLElement>("[data-filter-status]");

    const announce = (): void => {
      const visible = Array.from(
        document.querySelectorAll("#events-list [data-category] li"),
      ).filter((el) => el.getClientRects().length > 0).length;
      if (!status) return;
      const form =
        new Intl.PluralRules(document.documentElement.lang).select(visible) ===
        "one"
          ? status.dataset["statusOne"]
          : status.dataset["statusOther"];
      status.textContent = (form ?? "{n}").replace("{n}", String(visible));
    };

    const params = new URLSearchParams(location.search);
    const initial = params.get("categorie");
    if (initial) {
      const input = form.querySelector<HTMLInputElement>(
        `input[name="categorie"][value="${CSS.escape(initial)}"]`,
      );
      if (input) input.checked = true;
    }

    form.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;
      const url = new URL(location.href);
      if (input.value === "tous") url.searchParams.delete("categorie");
      else url.searchParams.set("categorie", input.value);
      history.replaceState(history.state, "", url);
      // Lets the language switcher carry the new query over.
      document.dispatchEvent(new CustomEvent("dzair:urlchange"));
      announce();
    });
  }

  document.addEventListener("astro:page-load", initFilter);
</script>
