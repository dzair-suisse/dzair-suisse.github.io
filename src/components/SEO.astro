---
import { SITE } from "../lib/site";
import { absoluteUrl, url } from "../lib/url";

export interface Props {
  /** Page title (without the site suffix). Omit on the home page. */
  title?: string | undefined;
  description?: string | undefined;
  /** Path relative to the base, e.g. "evenements/". */
  path?: string | undefined;
  /** Path (relative to base) of the social image in `public/`. */
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
  /** JSON-LD objects to embed. */
  jsonLd?: Record<string, unknown>[] | undefined;
}

const {
  title,
  description = SITE.description,
  path = "",
  image = "og-image.png",
  imageAlt = "Logo de DZAÏR – Association des étudiants algériens en Suisse",
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = absoluteUrl(path, Astro.site);
const ogImage = absoluteUrl(image, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex" />
) : (
  <link rel="canonical" href={canonical} />
)}

<link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
<link rel="icon" href={url("favicon.png")} type="image/png" sizes="any" />
<link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
<link rel="manifest" href={url("site.webmanifest")} />
<link rel="sitemap" href={url("sitemap-index.xml")} />

<meta
  name="theme-color"
  content="#0B4D3A"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#0f2a22"
  media="(prefers-color-scheme: dark)"
/>

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((data) => (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
  />
))}
