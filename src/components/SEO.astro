---
import { HTML_LANG, OG_LOCALE } from "../i18n/routes";
import {
  LANGS,
  localizedPath,
  useTranslations,
  type Lang,
} from "../i18n/utils";
import { SITE } from "../lib/site";
import { absoluteUrl, url } from "../lib/url";

export interface Props {
  lang: Lang;
  /** Page title (without the site suffix). Omit on the home page. */
  title?: string | undefined;
  description?: string | undefined;
  /** Path of this page relative to the base, e.g. "evenements/" or "en/events/". */
  path?: string | undefined;
  /** Path (relative to base) of the social image in `public/`. */
  image?: string | undefined;
  imageAlt?: string | undefined;
  /** Size of `image` (defaults: the 1200×630 site image). */
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  /** Open Graph type (`article` for an event page). */
  ogType?: "website" | "article" | undefined;
  noindex?: boolean | undefined;
  /** JSON-LD objects to embed. */
  jsonLd?: Record<string, unknown>[] | undefined;
}

const t = useTranslations(Astro.props.lang);
const {
  lang,
  title,
  description = t.site.description,
  path = "",
  image = "og-image.png",
  imageAlt = t.site.ogImageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  ogType = "website",
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : t.site.title;
// Same page in every language (hreflang alternates).
const alternates = LANGS.map((l) => ({
  hreflang: HTML_LANG[l],
  href: absoluteUrl(localizedPath(path, l), Astro.site),
}));
const xDefault = absoluteUrl(localizedPath(path, "fr"), Astro.site);
const canonical = absoluteUrl(path, Astro.site);
const ogImage = absoluteUrl(image, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex" />
) : (
  <link rel="canonical" href={canonical} />
)}
{!noindex &&
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
<link rel="icon" href={url("favicon.png")} type="image/png" sizes="any" />
<link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
<link rel="manifest" href={url("site.webmanifest")} />
<link rel="sitemap" href={url("sitemap-index.xml")} />

<meta
  name="theme-color"
  content="#0B4D3A"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#0f2a22"
  media="(prefers-color-scheme: dark)"
/>

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LANGS.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
))}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((data) => (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
  />
))}
